# iOS 버전 설정
platform :ios, '15.0'

# 프로젝트 파일 명시
project 'Runner.xcodeproj'

# [핵심] Flutter SDK 내부의 podhelper.rb를 직접 로드합니다.
# 사용자의 SDK 경로인 /Users/macbook/development/flutter를 기준으로 설정했습니다.
load '/Users/macbook/development/flutter/packages/flutter_tools/bin/podhelper.rb'

target 'Runner' do
  use_frameworks!

  # 이제 이 명령어를 정상적으로 인식합니다.
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # [Antigravity] Enable location permission macro for permission_handler
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_LOCATION=1',
        'PERMISSION_HEALTH=1'
      ]
    end
  end
end
